package com.office.example;

public class DataType {

	public static void main(String[] args) {
		System.out.println("This class is DataType.");

		/*
		 * 데이터 타입(Data Type) == 자료형
		 * 데이터 타입이란, 메모리에 데이터가 저장될 때 데이터에 따라서 할당 받는 메모리 크기가 다르게 되는데요,
		 * 예를 들어 정수는 1~8byte, 실수는 4 ~ 8byte의 크기가 할당됩니다.
		 * 
		 * [참고]
		 * 메모리 단위
		 * 1bit(비트) 			메모리 최소단위
		 * 8bit(비트)  			1byte(바이트)
		 * 1024byte(바이트)		1KB(키로 바이트)
		 * 1024KB(키로 바이트)  	1MG(메가 바이트)
		 * 1024MB(메가 바이트)		1GB(기가 바이트)
		 * 1024GB(기가 바이트) 	1TB(테라 바이트)
		 * 
		 * 이렇게 데이터에 따라서 메모리 크기를 달리 하는 이유는? 메모리를 효율적으로 사용하기 위해서
		 * 
		 * [참고]
		 * 데이터 타입의 진정한 의미
		 * 위에서는 데이터 타입을 가급적 쉽게 설명하기 위해서 메모리 크기에 따른 데이터 구분이라고 했는데요,
		 * 사실 데이터 타입은 메모리 크기뿐만 아니라 데이터의 저장 방식, 속성, 관련 명령 등에 따른 데이터 구분입니다.
		 * 하지만, 지금 이 모든 것을 학습하는 불가능하고 향후 프로그래밍 언어를 학습하다 보면 자연스럽게 알 수 있는 내용입니다.
		 *
		 */
		
		//--------------------------------------------------------------------------------
		/* 정수 데이터 타입 == 정수형
		 * byte		1byte(8bit)		-128 ~ 127
		 * short	2byte			-32.768 ~ 32,767
		 * int		4byte			-2,147,483,648 ~ 2,147,483,647
		 * long		8byte			-9,223,372,036,854,775,808 ~ 9,223,372,036,854,775,807
		 */
		
		// byte
		byte num = -128;
		System.out.println("num: " + num); // -128
		
		num = 127;
		System.out.println("num " + num);  // 127
		
//		num = -129;
//		System.out.println("num " + num);  // error
		
		// short
		short numShort = -32768;
		System.out.println("numShort: " + numShort);  // -32768
		numShort = 32767;
		System.out.println("numShort: " + numShort);  //  32767
		
		// int
		int numInt = -2147483648;
		System.out.println("numInt: " + numInt);    // -2147483648
		numInt = 2147483647;
		System.out.println("numInt: " + numInt);    // 2147483647
		
		// long
		long numLong = -9223372036854775808L;
		
		// -------------------------------------------------------
		/* 
		 * 실수 데이터 타입(부동소수)
		 * float 	4byte		-대략 3.4028235E38 ~ -3.4028235E38
		 * double 	8byte		-대략 -1.7976931348623157 ~ 1.7976931348623157
		 */
		
		float numFloat = 3.14f;
		System.out.println("numFloat: " + numFloat);
		
		double numDouble = 3.14;		
		System.out.println("numDouble: " + numDouble);
		
		float num1 = 3.14159265358979323846264338327950288f;
	    double num2 = 3.14159265358979323846264338327950288d;
	    
	    System.out.println("num1: " + num1);
	    System.out.println("num2: " + num2);

	    // ---------------------------------------------------------------------------------------
	    /*
	     * 논리 데이터 타입 == 논리형
	     * boolean 		1byte		true, false
	     */
	    
	    boolean flag = true;
	    System.out.println("flag: " + flag);
	    
	    flag = false;
	    System.out.println("flag: " + flag);
	    
	    
	    // -----------------------------------------------------------------------------------------
	    /* 
	     * 문자 데이터 타입 == 챠(char)
	     * java에서는 python이나 javascript 와 달리 문자와 문자열을 엄격하게 구분한다.
	     * char 	2byte		0 ~ 65535
	     */
		
	    char ch = 'a';
	    System.out.println("ch: " + ch);  // a
	    
	    ch = 'b'; 
	    System.out.println("ch: " + ch);  // b
	    
	    /*
	     * 빈(empty)문자, 공백(space)문자
	     * 빈(empty)문자: 말 그대로 아무것도 없는 문자  ---> ''
	     * 공백(space)문자: 말 그대로 공백 문자	    ---> ' '
	     */
	    
//	    char myChar='';			// X
	    char myChar=' ';		// O
	    System.out.println("myChar: " + myChar);
	    
	    /*
	     * 유니코드란?
	     * 문자가 메모리에 저장될 때 문자 자체로 저장되는 것이 아니고 유니코드로 저장된다.
	     * 유니코드란, 영어, 한글, 중국어 등의 전 세계 모든 문자를 정수로 나타낸 코드로 컴퓨터는
	     *  문자를 다룰 수 없기 떄문에 문자를 정수로 변환해서 사용한다.
	     */
	    
	    char char1 = 'A';
	    System.out.println("char1: " + char1);      // A -> 65
	    
	    int unicode1 = char1;                     // 65
	    System.out.println("unicode: " + unicode1);
	    
	    char char2 = 'ㄱ';
	    System.out.println("char2: " + char2);
	    
	    int unicode2 = char2;
	    System.out.println("unicode2: " + unicode2);
		
	    char char3 = '가';
	    int unicode3 = char3;
	    System.out.println("unicode3 " + unicode3);
	    
	    char char4 = 65;
	    System.out.println("char4: " + char4);
	}

}
