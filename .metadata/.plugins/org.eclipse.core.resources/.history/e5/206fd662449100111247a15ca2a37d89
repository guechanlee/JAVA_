package com.office.example;

public class Loop {
	public static void main(String[] args) {
		
		/*
		 * for문 & while문
		 */
		
		//     초기화     조건식   증감식
		for (int i = 0; i < 11; i++) {
			System.out.println("i: " + i);
		}
		
		int i = 0;
		for (; i < 11; i++ ) {
			System.out.println("i: " + i);
		}
	}
}
