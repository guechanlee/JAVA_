package com.office.example;

public class StringFormat {

	public static void main(String[] args) {
		
		/*
		 * 형식 문자열 출력
		 * 1. System.out.printf();
		 */
		
		String name = "Mr. Hong";
		System.out.println("name: " + name);   // name: Mr. Hong
		
		System.out.printf("name: %s\n", name);
		System.out.printf("name: %s\n", name);
		
		// %s --> 지정자
		/*
		 * 지정자 종류
		 * 1. %d 			: 정수형 출력       *****
		 * 2. %f  			: 실수형 출력		 *****
		 * 3. %c 			: 문자형 출력		 *****
		 * 4. %b 			: 논리형 출력	     *****
		 * 5. %o			: 8진수형 출력
		 * 6. %x 			: 16진수형 출력
		 * 7. %n			: 개행 == \n       ***
		 * 8. %s			: 문자열형 출력  	 *****
		 */
		
		System.out.printf("이름 : %s%n", "Mr. Hong");
		System.out.printf("성구분 : %c%n", 'W');			// 작은 따음표
		System.out.printf("나이 : %d%n", 20);
		System.out.printf("신장 : %f%n", 187.7);
		System.out.printf("체중 : %f%n", 85.5);
		System.out.printf("결혼유무 : %b%n", false);
		
		System.out.printf("10진수 %d > 8진수 %o\n", 123, 173);
		System.out.printf("10진수 %d > 16진수 %x\n", 123, 123);
		
		// 키와 몸무게는 188cm, 85.5kg이고 결혼은 false이다.
		System.out.printf("키와 몸무게는 %fcm, %fkg이고 결혼은 %b이다.",
				188.0 , 85.5, false);

		
		/*
		 * 지정자 옵션 사용하기
		 * 1. 소수점 아래 자리 수를 지정한다.
		 */
		
		float rate = 3.141592f;
		System.out.printf("rate: %f \n", rate);            // rate: 3.141592
		
		System.out.printf("rate: %.2f \n", rate);		   // rate: 3.14
		System.out.printf("rate: %.4f \n", rate);		   // rate: 3.1415	
		
		/* 
		 * 2. 전체 출력 자리수를 지정하고, 오른쪽 정렬한다.
		 */
		
		int num1 = 1;
		int num2 = 12;
		int num3 = 123;
		System.out.printf("num1: %d\n", num1);     // 1         앞에서 정렬
		System.out.printf("num2: %d\n", num2);     // 12
		System.out.printf("num3: %d\n", num3);     // 123
		
		System.out.printf("num1: %3d\n", num1);     //   1      3칸 뒤에서 정렬
		System.out.printf("num2: %3d\n", num2);     //  12
		System.out.printf("num3: %3d\n", num3);     // 123
		
		System.out.printf("num1: %5d\n", num1);     //     1    5칸 뒤에서 정렬
		System.out.printf("num2: %5d\n", num2);     //    12
		System.out.printf("num3: %5d\n", num3);     //   123
		
		System.out.printf("num1: %-5d\n", num1);     // 1     // 5칸 앞에서 정렬 뒤에 공백이 남아있다 
		System.out.printf("num2: %-5d\n", num2);     // 12
		System.out.printf("num3: %-5d\n", num3);     // 123
		
		System.out.printf("num1: %05d\n", num1);     // 00001
		System.out.printf("num2: %05d\n", num2);     // 00012
		System.out.printf("num3: %05d\n", num3);     // 00123
		
		double dou = 123.45678;
		System.out.printf("dou: %10.3f\n", dou); 		 //
		
		
		
	}

}
