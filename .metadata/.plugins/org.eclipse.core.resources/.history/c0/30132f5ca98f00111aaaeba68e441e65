package com.office.example;

/* 
 * 1. class란?
 * class(클래스)는 프로그램을 구성하는 단위.
 * 그래서 java 응용프로그램은 반듯이 하나 이상의 클래스 파일이 있어야 함.
 * 
 * 프로그램이란 것을 단순하게 생각해보면, 특정 기능들이 모여이는 집합체라고 할 수 있다.
 * 여기서 특정 기능들이 기술되어 있는 곳이 바로 '클래스' 이다.
 * 
 * 클래스는 기본적으로 'public', 'class' 키워드(예약어)를 사용하고 다음에 '클래스명(Ex001)'을 작성한다.
 * 다음에 클래스안에 코드의 시작과 끝 '{...}'를 이용한다.
 * 
 * 노션정리할때 중간중간에 그림 넣기
 * 
 * 2. 클래스 이름 규칙
 * 클래스 이름은 java 파일명과 무조건 동일하게 한다.
 * 따라서 하나의 java 파일에는 하나의 클래스가 있는 것이 일반적이다.
 * 하지만 일반적이지 않는 경우도 있어요. 하나의 java파일에 2개 이상의 클래스 선언(예전에 사용하던 방식)
 * 파일명과 동일한 이름으ㅢ 클래스는 스스로 public class를 넣는다
 * 
 * 클래스 이름은 영문 대문자로 시작하는 것이 일반적이다.
 * 숫자를 사용하고자 할때는 중간, 끝에만 사용 가능하다. 즉 클래스 이름의 첫 글자에는 사용하지 못한다.
 * Hello --> 0 
 * H2ello --> 0
 * Hello2 --> 0
 * 2Hello --> X
 * 
 * 일반적이지는 않지만 특수문자를 사용하는 경우가 있다. 이때 특수문자는 '$','_'만 사용가능.
 * _Hello --> O
 * H_ello --> O
 * Hello --> O
 * $Hello --> O
 * H$ello --> O
 * Hello$$ --> O
 * 
 * Hello@ --> X
 * Hello^^ --> X
 * 
 * 결론적으로 특수문자, 숫자는 가급적 사용하지 말자!
 */


public class Ex001 {
	
	/*
	 * main 메서드란?
	 * java 응용프로그램을 실행하면 JVM는 프로그램 내 많은 코드 중에서 가장 먼저 시작해야하는
	 * 코드를 찾아야 하는데요, 이때 가장 먼저 실행하는(즉 call하는) 코드가 바로 main 메서드이다.
	 * 즉, JVM는 main 메서드를 프로그램의 시작점으로 생각하고 프로그램을 실행 한다.
	 */
	public static void main(String[] args) {            // 프로그램 시작 점 for JVM
		System.out.println("Hello JAVA!");
	}
}
