package com.office.example;

public class Operator01 {
	
	public static void main(String[] args) {
		
		/*
		 * 1. 연산자 란?
		 * 각종 연산을 수행할 때 사용하는 '기호'이다.
		 * - 연산자 종류
		 * 	 : 산술 연산자 : +, -, *, /, %, ++, --
		 * 	 : 할당 연산자 : =, +=, -=, *=, /=, %=
		 * 	 : 비교 연산자 : ==, !=, >, <, >=, <=  
		 * 	 : 논리 연산자 : %%, ||, !
		 *   표에 명시한 연산자 말고도 조건 연산자,
		 *   비트 연산자 그리고 연산자와 관련한 몇 가지 메서드가 있는데요,
		 *   웹개발에도 몰라도 상관없다 
		 *   
		 *	연산식
		 *	피연산자 연산자
		 *
		 * 2. 산술 연산자
		 * 2-1. 숫자 덧셈(+)
		 *  : 숫자를 덧셈할 때 사용한다.
		 *  
		 * 2-2. 문자 덧셈(+)
		 *  : 문자열을 연결할 때 사용한다.
		 *  
		 * 2-3. 숫자와 문자열 덧셈
		 *  : 이런 경우 숫자가 문자열화 됩니다. number to String
		 *  
		 * 2-4. 문자 덧셈
		 *  : 문자 덧셈은 문자가 유니코드로 변경되어 덧셈 연산한다.
		 */
		
		int num1 = 10;
		int num2 = 20;
		System.out.println("num1 + num2 = " + (num1 + num2));
//		System.out.println("num1 + num2 = " + num1 + num2);
		
		float num3 = 0.1f;
		float num4 = 0.2f;
		System.out.println("num3 + num4 = " + (num3 + num4));
		
		String str1 = "Hello ";
		String str2 = "JAVA.";
		System.out.println("str1 + str2 = " + (str1 + str2)); 
		System.out.println("str1 + str2 = " + str1 + str2);
		
		System.out.println(10 + "Hello");    // 10Hello
		System.out.println(3.14f + "Hello");
		
		System.out.println('A' + 'B');       // 65 + 66 = 131
		System.out.println('가' + '나');      // 44032 + 45208 = 89240
		
		char charA = 'A';
		char charB = 'B';
		int charInt = charA + charB;
		
		/*
		 * 2-5. 숫자 뺼셈
		 *  : 수학에서의 숫자 뺼셈과 동일함
		 * 
		 * 2-6. 문자열 뺄셈
		 *  : 문자열 뺄셈은 불가하다.
		 *  
		 * 2-7. 숫자와 문자열 뺄셈
		 *  : 숫자와 문자열 뺄셈 불가하다.
		 *  
		 * 2-8. 문자 뺄셈
		 *  : 문자 뺄셈은 문자가 유니코드로 변경되어 뺄셈 연산한다.
		 */
		
//		2-5
		System.out.println("10 - 20 = "  + (10 - 20));         // - 10
		System.out.println("0.1f - 0.2f = " + (0.1f - 0.2f));  // -0.1
		
//		2-6
//		System.out.println("Hello" - "JAVA");  // Exception(Error)
		
//		2-7
//		System.out.println(10 - "JAVA");	   // Exception(Error)	
		
//		2-8
		System.out.println('A' - 'B');    // -1
		System.out.println('가' - '나');   // -1176
		
		/*
		 * 2-9. 숫자 곱셈
		 *  : 수학에서의 곱셈과 동일하다.
		 *  
		 * 2-10. 숫자와 문자열 곱셈
		 *  : 불가하다.
		 */
		
//		2-9
		System.out.println(10 * 3);       // 30
		System.out.println(0.2f * 3);     // 0.6
		
//		2-10
//		System.out.println(3 * "Hello");    // Exception(Error)
//		System.out.println("Hello" * 3);    // Exception(Error)
		
		// at python : "Hello" * 3 --> HelloHelloHello
		
		/*
		 * 2-11. 숫자 나눗셈
		 *  : 수학과 동일하다.
		 *  
		 * 2-12. 문자 나눗셈
		 *  : 유니코드를 이용한 연산 가능.
		 *  
		 * 2-13. 0으로 나눗셈
		 *  : 세상의 어떤 수도 0으로 나눌 수는 없다.
		 */

		
//		2-11
		System.out.println(10 / 20);            // 0.5(X)  0
//		int 와 int 가 나눠지면 소수점이 날라감
		
		System.out.println((float)10 / 20);     // 0.5
//		둘중에 하나라도 float, double이라면 소수점 출력
		
//		2-12
		System.out.println((float)'A' / 'B');   // 0.9848485
		
//		2-13
		System.out.println(10 / 0);
		
		
		
	

		
		
	}
	
}
